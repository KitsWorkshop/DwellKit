#!/usr/bin/env bash
#
# dwellkit — deploy "The Secret You Can't Delete" to students.
#
#   ./dwellkit build   <student-id>              one repository
#   ./dwellkit class   <roster.csv> [--dry-run]  a whole cohort
#   ./dwellkit status  <results.csv> [--remind]  who hasn't accepted yet
#
# Environment:
#   GH_TOKEN    required   token with repo + workflow scope on GH_ORG
#   GH_ORG      required   organisation to build into
#   KIT_SALT    see below  per-cohort secret; required by `class` (not by `class --dry-run`)
#   KIT_PREFIX  optional   repo name prefix (default: hackathon-starter-)
#   CONCURRENCY optional   parallel builds during `class` (default: 5)
#
# KIT_SALT makes credentials reproducible: a repo can be rebuilt identically
# after a failure, and any student's value can be re-derived for marking
# without having recorded thirty of them. `build` without a salt produces a
# random credential, which is correct for one-off builds.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_PREFIX="${KIT_PREFIX:-hackathon-starter-}"

# ===========================================================================
# Shared definitions.
#
# Everything below is defined exactly once and used by every subcommand.
# Credential derivation and repo naming were previously duplicated across two
# scripts; the prefix defaults had already silently drifted apart, which meant
# a class built by fan-out got different repo names than one built directly.
# ===========================================================================

usage() { sed -n '3,20p' "$0" | sed 's/^# \?//'; }

die() { echo >&2; printf '%s\n' "$@" >&2; echo >&2; exit 1; }

# Every subcommand shells out to these. Without a check the first failure is
# "command not found", several lines into output that looks like it is working.
require_tools() {
  local missing=() t
  for t in git gh curl sha256sum; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    die "Missing required tool(s): ${missing[*]}" \
        "" \
        "  git   https://git-scm.com/downloads" \
        "  gh    https://cli.github.com  — then run: gh auth login" \
        "  curl, sha256sum are usually preinstalled (coreutils)"
  fi
}

require_env() {
  require_tools
  local missing=()
  [ -z "${GH_TOKEN:-}" ] && missing+=("GH_TOKEN")
  [ -z "${GH_ORG:-}" ]   && missing+=("GH_ORG")
  if [ "${#missing[@]}" -gt 0 ]; then
    die "Missing required environment: ${missing[*]}" \
        "" \
        "  export GH_TOKEN=<token>   # needs 'repo' and 'workflow' scope on the org" \
        "  export GH_ORG=<org>       # the organisation to build into" \
        "" \
        "Create a token at https://github.com/settings/tokens" \
        "(If the org enforces SAML SSO, authorise the token for it there too.)" \
        "" \
        "These are deliberately not guessed: without GH_ORG the script would" \
        "otherwise build student repositories in your personal namespace."
  fi
  export GH_TOKEN
}

repo_name_for() { printf '%s%s' "$KIT_PREFIX" "$1"; }

# WARNING: this credential format is UNVALIDATED against GitHub push
# protection. No format testing was possible (the build org has no secret
# scanning — see docs/TECHNICAL-NOTES.md Phase 3). If you deploy to an org that HAS
# push protection enabled, verify this format is not blocked before running a
# class fan-out, or every student repo will fail to push at once.
credential_for() {
  if [ -n "${KIT_SALT:-}" ]; then
    printf 'sk_staging_%s' "$(printf '%s' "${1}${KIT_SALT}" | sha256sum | cut -c1-40)"
  else
    printf 'sk_staging_%s' "$(python3 -c 'import secrets; print(secrets.token_hex(20))')"
  fi
}

# ===========================================================================
# build — one student repository, from bundle to red CI.
#
# Plain, linear shell by design. Every numbered step is a stand-in for a
# future kitscript task/microtask; each comment names the eventual task.
# ===========================================================================
cmd_build() {
  [ $# -ge 1 ] || die "dwellkit build — build one student repository" \
                       "" \
                       "  usage: ./dwellkit build <student-id>" \
                       "" \
                       "  example: ./dwellkit build amara" \
                       "           -> \$GH_ORG/${KIT_PREFIX}amara"
  local SUFFIX="$1"
  require_env

  case "$SUFFIX" in
    *[!A-Za-z0-9._-]*|-*|.*|"")
      die "Invalid student id: '$SUFFIX'" \
          "" \
          "  It becomes part of a GitHub repository name, so it may contain only" \
          "  letters, digits, dot, dash and underscore, and may not start with" \
          "  a dash or a dot." \
          "" \
          "  example: ./dwellkit build amara" ;;
  esac

  local REPO_NAME; REPO_NAME="$(repo_name_for "$SUFFIX")"
  case "$REPO_NAME" in
    "${KIT_PREFIX}"*) ;;
    *) die "Refusing to build '$REPO_NAME'." \
            "" \
            "  It does not start with KIT_PREFIX ('$KIT_PREFIX')." \
            "  This guard keeps the kit from creating or touching repositories" \
            "  outside its own namespace. Check the student-id argument." ;;
  esac

  # Deliberately NOT `local`: the EXIT trap fires after this function's scope
  # is gone, so a local would be unbound by then — which under `set -u` both
  # printed a confusing error and skipped the cleanup, leaking a ~40MB
  # checkout on every failed build.
  WORKDIR="$(mktemp -d)"
  trap 'rm -rf "${WORKDIR:-}"' EXIT

  local CREDENTIAL_VALUE; CREDENTIAL_VALUE="$(credential_for "$SUFFIX")"

  echo "==> Building $REPO_NAME in org $GH_ORG"

  # -------------------------------------------------------------------------
  # Step 1 — floor: unpack the authentic history bundle.
  # Eventual kitscript task: git-bundle-checkout
  # (does not exist yet; this is plain `git clone` against a bundle file,
  # which is exactly what that task needs to wrap.)
  # -------------------------------------------------------------------------
  echo "==> [1/8] Unpacking floor bundle"
  git clone --quiet "$SCRIPT_DIR/floor.bundle" "$WORKDIR/repo"
  cd "$WORKDIR/repo"
  git checkout --quiet -b main origin/floor
  git remote remove origin

  # -------------------------------------------------------------------------
  # Step 2 — tail: apply the scripted patch series on top of the floor.
  # Eventual kitscript task: git-tail-apply (out of scope to build as a
  # reusable image for now — inline is correct here).
  # Substitutes the __KIT_SECRET__ placeholder for the real credential value
  # as each patch is applied, so no working credential is ever stored on disk.
  # -------------------------------------------------------------------------
  echo "==> [2/8] Applying tail patch series"
  local patch
  for patch in "$SCRIPT_DIR"/tail/*.patch; do
    sed "s/__KIT_SECRET__/${CREDENTIAL_VALUE}/g" "$patch" > "$WORKDIR/patch.tmp"
    # --whitespace=nowarn: most of these patches are real upstream commits and
    # carry the upstream project's own whitespace quirks. The warnings are
    # cosmetic and would otherwise bury the build output in noise.
    git am --quiet --committer-date-is-author-date --whitespace=nowarn "$WORKDIR/patch.tmp"
  done
  rm -f "$WORKDIR/patch.tmp"
  echo "    tail applied: $(ls "$SCRIPT_DIR"/tail/*.patch | wc -l | tr -d ' ') commits on top of floor"

  # -------------------------------------------------------------------------
  # Step 3 — create the private repo under the prefix.
  # Eventual kitscript task: github-repo-create (with: services: github)
  # The description is student-visible on the repo page: it must not hint
  # that this is a constructed exercise.
  # -------------------------------------------------------------------------
  echo "==> [3/8] Creating private repo $GH_ORG/$REPO_NAME"
  gh repo create "$GH_ORG/$REPO_NAME" --private --description "Hackathon starter application" >/dev/null

  # -------------------------------------------------------------------------
  # Step 4 — push floor + tail.
  # Eventual kitscript task: git-push (generic, likely already exists)
  # -------------------------------------------------------------------------
  echo "==> [4/8] Pushing floor + tail"
  # Auth via a per-invocation header rather than embedding the token in the
  # remote URL — an embedded-token URL gets echoed back by things like
  # `git remote -v`, .git/config, and tool notices (e.g. git-filter-repo's
  # "removing origin remote" message), which is a needless leak surface.
  local AUTH_HEADER
  local PUSH_ERR
  AUTH_HEADER="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)"
  git remote add origin "https://github.com/${GH_ORG}/${REPO_NAME}.git"

  # This push carries the planted credential, so it is where GitHub secret
  # scanning would reject it. That failure is the one that takes out an entire
  # cohort at once, and raw git output does not say so — hence the translation.
  if ! PUSH_ERR="$(git -c http.extraheader="$AUTH_HEADER" push origin main 2>&1)"; then
    case "$PUSH_ERR" in
      *GH013*|*"push protection"*|*"secret scanning"*|*"Push cannot contain secrets"*)
        die "Push BLOCKED by GitHub secret scanning (push protection)." \
            "" \
            "  The planted credential format was recognised and refused." \
            "" \
            "  ⚠ This affects EVERY student repository identically — do not" \
            "    start a fan-out until it is resolved." \
            "" \
            "  Fix: change the credential format in credential_for() near the top" \
            "  of this script (currently 'sk_staging_' + 40 hex), then rebuild and" \
            "  re-test. Repository '$REPO_NAME' has been created but is empty;" \
            "  delete it before retrying." \
            "" \
            "  --- git said ---" \
            "$PUSH_ERR" ;;
      *)
        die "Push failed for '$REPO_NAME'." \
            "" \
            "  --- git said ---" \
            "$PUSH_ERR" ;;
    esac
  fi

  # Pin the default branch explicitly rather than relying on GitHub adopting
  # the first pushed branch. An org can configure a different default branch
  # name; if that happens, HEAD points at a branch that was never created and
  # students clone with nothing checked out ("remote HEAD refers to nonexistent
  # ref"). Harmless and idempotent when main is already the default.
  gh api -X PATCH "repos/${GH_ORG}/${REPO_NAME}" -f default_branch=main >/dev/null 2>&1 \
    || echo "    note: could not set default branch (main was pushed regardless)"

  # -------------------------------------------------------------------------
  # Step 5 — set the Actions repo secret.
  # Eventual kitscript task: github-repo-secret-set.
  #
  # The agent-spec assumed this needed hand-rolled libsodium sealed-box
  # encryption against the repo's public key. It does not: `gh secret set`
  # performs that encryption locally before transmitting. This replaced ~19
  # lines of PyNaCl and one dependency with the line below.
  # -------------------------------------------------------------------------
  echo "==> [5/8] Setting STAGING_API_KEY repo secret"
  gh secret set STAGING_API_KEY --body "$CREDENTIAL_VALUE" --repo "${GH_ORG}/${REPO_NAME}"

  # -------------------------------------------------------------------------
  # Step 6 — add the workflow that turns red/green on the credential.
  # Eventual kitscript task: probably folds into the same repo-bootstrap task
  # as step 3/4 — a file written into the tree before the first push, rather
  # than a separate task. Written here as a second commit + push for clarity
  # of what changed and when.
  # -------------------------------------------------------------------------
  echo "==> [6/8] Adding staging-deploy workflow"
  mkdir -p .github/workflows
  # Compare a hash of the known-leaked value, not the raw value itself — the
  # workflow file is a tracked, permanent part of the repo, so embedding the
  # plaintext credential here would defeat "invisible in the working tree"
  # forever, even after the student deletes config/staging.env.
  #
  # SPOILER DISCIPLINE. GitHub Actions echoes the entire `run:` block into the
  # log, and the job and step names show in the checks UI. All of it is student-
  # visible, so none of it may explain the exercise. This reads as an ordinary
  # deploy rejecting a revoked credential — which is exactly what a leaked key
  # looks like in production once a scanning partner has auto-revoked it.
  #
  # Specifically, nothing here may mention git history. A student who reads the
  # workflow learns only "the key must differ from a known-bad one" — not that
  # the old value is still recoverable. That reveal has to stay theirs to find.
  local LEAKED_VALUE_HASH
  LEAKED_VALUE_HASH="$(printf '%s' "$CREDENTIAL_VALUE" | sha256sum | cut -d' ' -f1)"
  cat > .github/workflows/staging-deploy.yml <<EOF
name: staging-deploy
on: [push]
jobs:
  deploy-staging:
    runs-on: ubuntu-latest
    steps:
      - name: Authenticate with staging API
        env:
          STAGING_API_KEY: \${{ secrets.STAGING_API_KEY }}
        run: |
          # Pre-flight check. The provider revokes keys that have been reported
          # as exposed; deploying with one just fails further down the pipeline.
          KEY_FINGERPRINT=\$(printf '%s' "\$STAGING_API_KEY" | sha256sum | cut -d' ' -f1)
          REVOKED_FINGERPRINT="${LEAKED_VALUE_HASH}"

          if [ "\$KEY_FINGERPRINT" = "\$REVOKED_FINGERPRINT" ]; then
            echo "::error::staging deploy failed — upstream returned 401 Unauthorized"
            echo "The credential in STAGING_API_KEY was rejected by the staging API."
            exit 1
          fi

          echo "staging deploy: authenticated OK"
EOF
  git add .github/workflows/staging-deploy.yml
  GIT_AUTHOR_NAME="Priya Natarajan" GIT_AUTHOR_EMAIL="pnatarajan@users.noreply.github.com" \
  GIT_COMMITTER_NAME="Priya Natarajan" GIT_COMMITTER_EMAIL="pnatarajan@users.noreply.github.com" \
    git commit --quiet -m "ci: add staging deploy workflow"

  # -------------------------------------------------------------------------
  # Step 7 — replace the upstream README with the student brief.
  #
  # The upstream README is ~1,570 lines of boilerplate marketing (testimonials,
  # Product Hunt quotes) — too long to read, and it undercuts the premise that
  # this is an internal application the student has inherited. The replacement
  # carries the exercise brief plus a short, genuine "how to run it" section.
  #
  # Edit templates/student-README.md to change the brief; no need to touch this
  # script. It deliberately does NOT mention rotation, history search, or that
  # the history was tampered with — working those out is the exercise.
  # -------------------------------------------------------------------------
  echo "==> [7/8] Installing student README + brief"
  cp "$SCRIPT_DIR/templates/student-README.md" README.md
  git add README.md
  git commit --quiet -m "docs: replace README with project overview and task brief"
  git -c http.extraheader="$AUTH_HEADER" push --quiet origin main

  # -------------------------------------------------------------------------
  # Step 8 — confirm branch protection is off, report the result.
  # Students must be able to force-push; protection here would block the
  # history rewrite the exercise depends on.
  # -------------------------------------------------------------------------
  echo "==> [8/8] Confirming branch protection is off"
  if gh api "repos/${GH_ORG}/${REPO_NAME}/branches/main/protection" >/dev/null 2>&1; then
    echo "    WARNING: branch protection is ON for main (expected off)"
  else
    echo "    OK: no branch protection on main"
  fi

  cd "$SCRIPT_DIR"
  echo "==> Done: https://github.com/${GH_ORG}/${REPO_NAME}"
  echo "    credential value (redact before sharing notes): ${CREDENTIAL_VALUE}"
}

# ===========================================================================
# class — build and hand out one repository per student.
#
# Direct API fan-out with outside-collaborator invitations. Deliberately does
# NOT use GitHub Classroom template assignments — those provision repos with a
# single commit, which would destroy this kit's 3,060-commit history.
# See docs/FANOUT-DESIGN.md.
#
# Roster format (header required):
#   student_id,github_username
#   alice,alice-gh
#
# Re-runnable: students whose repo already exists are skipped (the invitation
# is re-sent regardless, since PUT on collaborators is idempotent). Safe to
# run again after a partial failure.
# ===========================================================================
cmd_class() {
  [ $# -ge 1 ] || die "dwellkit class — deploy to a whole cohort" \
                       "" \
                       "  usage: ./dwellkit class <roster.csv> [--dry-run]" \
                       "" \
                       "  The roster is CSV with a header row:" \
                       "      student_id,github_username" \
                       "      amara,amara-gh" \
                       "" \
                       "  Start with:  cp roster.example.csv roster.csv"
  local ROSTER="$1"
  local DRY_RUN=false
  [ "${2:-}" = "--dry-run" ] && DRY_RUN=true

  require_env

  # KIT_SALT is what makes credentials reproducible, so a real run cannot
  # proceed without it. A dry run never derives a credential, though, and
  # requiring one just to check a roster for typos is friction for no gain —
  # so warn there instead of refusing, and still say the real run will fail.
  if [ -z "${KIT_SALT:-}" ]; then
    if [ "$DRY_RUN" = true ]; then
      echo "    NOTE: KIT_SALT is not set. Fine for --dry-run, which derives no credentials."
      echo "          The real run will refuse without it."
      KIT_SALT=""
    else
      die "KIT_SALT is not set." \
          "" \
          "  It is a per-cohort secret string of your choosing. It makes each" \
          "  student's credential reproducible, so a repo can be rebuilt after a" \
          "  failure and any value re-derived for marking." \
          "" \
          "  export KIT_SALT=<any secret string — write it down and keep it>" \
          "" \
          "  Not needed for --dry-run."
    fi
  fi

  local CONCURRENCY="${CONCURRENCY:-5}"
  export GH_ORG KIT_PREFIX KIT_SALT SCRIPT_DIR

  [ -f "$ROSTER" ] || die "Roster file not found: $ROSTER" \
                          "" \
                          "  Expected CSV with a header row:" \
                          "      student_id,github_username" \
                          "      amara,amara-gh" \
                          "" \
                          "  Start with:  cp roster.example.csv roster.csv"

  echo "==> Fan-out: org=$GH_ORG prefix=$KIT_PREFIX concurrency=$CONCURRENCY"

  # ---- Phase 1: preflight -------------------------------------------------
  #
  # These probes exist for deploying into an org you have not used before.
  # Several org settings need the `admin:org` scope to read, which a build
  # token legitimately may not have — so anything unreadable is reported as
  # "could not verify", never as a failure. Only two things are hard errors:
  # an unreachable org, and a token that SAML has not authorised.
  echo "==> [1/4] Preflight"

  local HDRS
  HDRS="$(curl -sI -H "Authorization: token $GH_TOKEN" \
          "https://api.github.com/orgs/${GH_ORG}" | tr -d '\r')"

  # SAML SSO: the token is valid and the org is visible, but every write 403s
  # until the token is authorised for the org. Detected by a response header,
  # because the failure is otherwise invisible until the first build dies.
  if printf '%s' "$HDRS" | grep -qi '^x-github-sso:'; then
    echo "    FAIL: '$GH_ORG' enforces SAML SSO and this token is not authorised for it." >&2
    echo "          Authorise it at https://github.com/settings/tokens (SSO button next to the token)." >&2
    exit 1
  fi

  gh api "orgs/${GH_ORG}" --jq '.login' >/dev/null 2>&1 \
    || die "Cannot reach organisation '$GH_ORG' with this token." \
           "" \
           "  Check that the org name is spelled correctly, that the token has" \
           "  'repo' scope, and that you are a member of the org."
  echo "    ✓ org reachable: $GH_ORG"

  local SCOPES
  SCOPES="$(curl -sI -H "Authorization: token $GH_TOKEN" https://api.github.com/user \
            | tr -d '\r' | awk -F': ' 'tolower($1)=="x-oauth-scopes"{print $2}')"
  echo "    token scopes: ${SCOPES:-<none reported>}"
  case "$SCOPES" in
    *repo*) ;;
    *) echo "    ⚠ token does not report the 'repo' scope; repo creation will likely fail" >&2 ;;
  esac

  # Role in the org — owner or member both work, but a non-member cannot create.
  local ME ROLE
  ME="$(gh api user --jq '.login' 2>/dev/null || true)"
  ROLE="$(gh api "orgs/${GH_ORG}/memberships/${ME}" --jq '.role' 2>/dev/null || true)"
  case "$ROLE" in
    admin|member) echo "    ✓ org membership: $ME ($ROLE)" ;;
    *)            echo "    ⚠ could not confirm org membership for '$ME' — repo creation may be refused" ;;
  esac

  # Outside-collaborator policy. `class` distributes entirely through the
  # collaborators endpoint; if the org forbids outside collaborators, nothing
  # reaches the students even though every build succeeds.
  local OC
  OC="$(gh api "orgs/${GH_ORG}" --jq '.members_can_create_private_repositories' 2>/dev/null || true)"
  if [ "$OC" = "false" ]; then
    echo "    ⚠ members cannot create private repositories in this org — you may need owner rights"
  fi
  if gh api "orgs/${GH_ORG}/outside_collaborators?per_page=1" >/dev/null 2>&1; then
    echo "    ✓ outside collaborators readable"
  else
    echo "    ⚠ could not verify outside-collaborator policy (needs admin:org) — confirm manually"
    echo "      that this org permits outside collaborators, or students cannot be invited"
  fi

  # Actions must be on, or CI never runs and there is no exercise.
  local ACT
  ACT="$(gh api "orgs/${GH_ORG}/actions/permissions" --jq '.enabled_repositories' 2>/dev/null || true)"
  case "$ACT" in
    all|selected) echo "    ✓ Actions enabled for org repositories ($ACT)" ;;
    none)         die "GitHub Actions is disabled for organisation '$GH_ORG'." \
                      "" \
                      "  The exercise depends on a failing CI check. Without Actions" \
                      "  there is nothing for students to diagnose." \
                      "  Enable it under Settings -> Actions -> General." ;;
    *)            echo "    ⚠ could not verify Actions policy (needs admin:org) — confirm CI runs on a test build" ;;
  esac

  echo "    NOTE: push protection against the credential format is NOT checked here."
  echo "          Run './dwellkit build pilot1' once in this org before a real fan-out."

  # ---- Phase 2: validate the roster before creating anything --------------
  # A typo caught here costs seconds; caught on the day it costs a student
  # their session. This is why validation is a separate phase.
  echo "==> [2/4] Validating roster"
  local ROWS=() INVALID=0 SEEN_IDS="" LINE_NO=0
  local student_id github_username _rest
  while IFS=, read -r student_id github_username _rest; do
    LINE_NO=$((LINE_NO+1))
    student_id="$(echo "${student_id:-}" | tr -d ' \r')"
    github_username="$(echo "${github_username:-}" | tr -d ' \r')"

    [ "$LINE_NO" -eq 1 ] && [ "$student_id" = "student_id" ] && continue   # header
    [ -z "$student_id" ] && continue                                       # blank line

    if [ -z "$github_username" ]; then
      echo "    INVALID line $LINE_NO: '$student_id' has no github_username"; INVALID=$((INVALID+1)); continue
    fi
    case " $SEEN_IDS " in *" $student_id "*)
      echo "    INVALID line $LINE_NO: duplicate student_id '$student_id'"; INVALID=$((INVALID+1)); continue ;;
    esac
    SEEN_IDS="$SEEN_IDS $student_id"

    if gh api "users/${github_username}" --jq '.login' >/dev/null 2>&1; then
      ROWS+=("${student_id},${github_username}")
    else
      echo "    INVALID line $LINE_NO: GitHub user '$github_username' does not exist (student '$student_id')"
      INVALID=$((INVALID+1))
    fi
  done < "$ROSTER"

  echo "    valid: ${#ROWS[@]}    invalid: $INVALID"
  if [ "$INVALID" -gt 0 ]; then
    echo "    FAIL: fix the roster before running. Nothing has been created." >&2
    exit 1
  fi
  [ "${#ROWS[@]}" -eq 0 ] && die "Roster has no usable rows: $ROSTER" \
                                 "" \
                                 "  A header line alone is not enough — add one row per student."

  if [ "$DRY_RUN" = true ]; then
    echo "==> Dry run complete. Roster is valid. Nothing created."
    exit 0
  fi

  # ---- Phase 3: build + invite, with bounded concurrency ------------------
  # Concurrency is capped because GitHub's *secondary* rate limits trigger on
  # burst concurrency rather than total volume, and are not visible in the
  # standard rate-limit headers.
  echo "==> [3/4] Building and inviting (${#ROWS[@]} students)"
  OUTDIR="$(mktemp -d)"          # not `local`, for the same reason as WORKDIR
  trap 'rm -rf "${OUTDIR:-}"' EXIT

  printf '%s\n' "${ROWS[@]}" \
    | xargs -P "$CONCURRENCY" -I{} bash -c \
        'IFS=, read -r sid ghu <<< "{}"; "$SCRIPT_DIR/dwellkit" _deploy-one "$sid" "$ghu" "'"$OUTDIR"'"'

  # ---- Phase 4: report ----------------------------------------------------
  echo "==> [4/4] Results"
  # Name and stamp the file with the org. Running two orgs in one afternoon
  # otherwise produces files distinguishable only by clock time, and `status`
  # takes the org from the environment — so a mismatched pair silently reports
  # every student as missing rather than erroring.
  local RESULTS; RESULTS="dwellkit-results-${GH_ORG}-$(date +%Y%m%d-%H%M%S).csv"
  {
    echo "# dwellkit results"
    echo "# org=${GH_ORG}"
    echo "# prefix=${KIT_PREFIX}"
    echo "# generated=$(date -Iseconds)"
    echo "student_id,github_username,repo,credential,status,notified,note"
  } > "$RESULTS"
  cat "$OUTDIR"/*.row 2>/dev/null | sort >> "$RESULTS" || true

  local OK FAILED
  OK=$(grep -c ',ok,' "$RESULTS" || true)
  FAILED=$(grep -cE ',(build-failed|invite-failed),' "$RESULTS" || true)

  grep -v '^#' "$RESULTS" | column -s, -t | sed 's/^/    /' | cut -c1-140
  echo
  echo "==> Wrote $RESULTS  (ok: $OK, failed: $FAILED)"
  echo "    This file contains credential values — it is gitignored. Do not commit or share it."
  if [ "$FAILED" -gt 0 ]; then
    cp "$OUTDIR"/*.log . 2>/dev/null || true
    echo "    Failure logs copied to the current directory."
    echo "    Re-run the same command to retry — existing repos are skipped."
  fi
  # Who did GitHub actually tell? Org members are added silently, so without
  # this line an instructor has no way to know which students were never
  # contacted by anything.
  local SILENT
  SILENT=$(grep -c ',added-silently,' "$RESULTS" || true)
  if [ "$SILENT" -gt 0 ]; then
    echo
    echo "    ⚠ $SILENT student(s) were added SILENTLY (already org members — GitHub sent them nothing)."
    grep ',added-silently,' "$RESULTS" | cut -d, -f1,2 | sed 's/^/        /'
    echo "      They each have an assigned issue in their repo, which does notify."
    echo "      Send them the URL yourself as well — do not rely on either channel alone."
  fi

  echo
  echo "    NEXT: students must ACCEPT their invitations before they can clone."
  echo "          Run ./dwellkit status $RESULTS daily until everyone has."
}

# ---------------------------------------------------------------------------
# _deploy-one — internal. One student, invoked by the concurrency layer above.
# ---------------------------------------------------------------------------
cmd_deploy_one() {
  local STUDENT_ID="$1" GH_USER="$2" OUTDIR="$3"
  local REPO_NAME; REPO_NAME="$(repo_name_for "$STUDENT_ID")"
  local STATUS="ok" NOTE=""
  local CREDENTIAL; CREDENTIAL="$(credential_for "$STUDENT_ID")"

  if gh api "repos/${GH_ORG}/${REPO_NAME}" >/dev/null 2>&1; then
    NOTE="repo already existed; build skipped"
  else
    if ! "$SCRIPT_DIR/dwellkit" build "$STUDENT_ID" >"$OUTDIR/$STUDENT_ID.build.log" 2>&1; then
      # Record the basename, not the temp path: logs are copied into the
      # working directory on failure, and $OUTDIR is deleted on exit.
      printf '%s,%s,%s,,build-failed,none,see %s\n' \
        "$STUDENT_ID" "$GH_USER" "$REPO_NAME" "$STUDENT_ID.build.log" > "$OUTDIR/$STUDENT_ID.row"
      return 0
    fi
  fi

  # PUT is idempotent: re-running does not create duplicate invitations.
  # The response distinguishes the two cases and they behave very differently:
  #   201 + an invitation object -> outside collaborator; GitHub emails them.
  #   204 No Content             -> already an org member; added silently, NO
  #                                 notification of any kind is sent.
  local INVITE_OUT NOTIFIED
  if INVITE_OUT="$(gh api -X PUT "repos/${GH_ORG}/${REPO_NAME}/collaborators/${GH_USER}" \
        -f permission=push 2>"$OUTDIR/$STUDENT_ID.invite.log")"; then
    if printf '%s' "$INVITE_OUT" | grep -q '"invitee"'; then
      NOTIFIED="invited"          # GitHub sent an invitation email
    else
      NOTIFIED="added-silently"   # org member: access granted, nobody told
    fi
  else
    STATUS="invite-failed"
    NOTE="see $STUDENT_ID.invite.log"
    NOTIFIED="none"
  fi

  # File a ticket in the repo, assigned to the student.
  #
  # Two jobs. It notifies org members, who receive nothing from the collaborator
  # call above. And it frames the work the way it actually arrives in a job: as
  # a ticket you inherited, not an exercise you were handed.
  #
  # Assignment only sticks once the student can see the repo, so for a pending
  # invitation GitHub silently drops the assignee — the issue is still created
  # and is waiting for them when they accept. Their invitation email is the
  # notification in that case, so nobody is left uncontacted either way.
  if [ "$STATUS" = "ok" ] && [ -f "$SCRIPT_DIR/templates/student-issue.md" ]; then
    local ISSUE_TITLE="Staging deploys are failing"
    local EXISTING ISSUE_NUM ASSIGNEES
    EXISTING="$(gh issue list --repo "${GH_ORG}/${REPO_NAME}" --state all \
                  --json number,title,assignees \
                  --jq ".[] | select(.title == \"$ISSUE_TITLE\") | \"\(.number) \(.assignees | length)\"" \
                2>/dev/null | head -1)"

    if [ -z "$EXISTING" ]; then
      # Idempotent: only ever open one copy.
      sed "s/__STUDENT__/${GH_USER}/g" "$SCRIPT_DIR/templates/student-issue.md" \
        > "$OUTDIR/$STUDENT_ID.issue.md"
      gh issue create --repo "${GH_ORG}/${REPO_NAME}" \
        --title "$ISSUE_TITLE" \
        --body-file "$OUTDIR/$STUDENT_ID.issue.md" \
        --assignee "$GH_USER" >/dev/null 2>&1 \
      || gh issue create --repo "${GH_ORG}/${REPO_NAME}" \
           --title "$ISSUE_TITLE" \
           --body-file "$OUTDIR/$STUDENT_ID.issue.md" >/dev/null 2>&1 \
      || NOTE="${NOTE:+$NOTE; }issue not created"
    else
      # The issue exists. If it has no assignee, the student had not accepted
      # their invitation when it was filed — GitHub requires push access to be
      # assignable and drops the assignee silently, and nothing back-fills it
      # later. Re-running after acceptance repairs that; until then the
      # invitation email is what reaches them.
      ISSUE_NUM="${EXISTING%% *}"
      ASSIGNEES="${EXISTING##* }"
      if [ "$ASSIGNEES" = "0" ]; then
        if gh issue edit "$ISSUE_NUM" --repo "${GH_ORG}/${REPO_NAME}" \
             --add-assignee "$GH_USER" >/dev/null 2>&1; then
          NOTE="${NOTE:+$NOTE; }issue assigned on re-run"
        else
          NOTE="${NOTE:+$NOTE; }issue unassigned (student has not accepted yet)"
        fi
      fi
    fi
  fi

  printf '%s,%s,%s,%s,%s,%s,%s\n' \
    "$STUDENT_ID" "$GH_USER" "$REPO_NAME" "$CREDENTIAL" "$STATUS" "${NOTIFIED:-unknown}" "$NOTE" > "$OUTDIR/$STUDENT_ID.row"
}

# ===========================================================================
# status — who still hasn't accepted their repository invitation?
#
# An unaccepted invitation is the single most likely reason a student cannot
# start the exercise. Run this daily in the week before class.
# ===========================================================================
cmd_status() {
  [ $# -ge 1 ] || die "dwellkit status — who has accepted their invitation" \
                       "" \
                       "  usage: ./dwellkit status <results.csv> [--remind]" \
                       "" \
                       "  The results file is written by 'dwellkit class':" \
                       "      ./dwellkit status dwellkit-results-\$GH_ORG-*.csv" \
                       "" \
                       "  --remind re-sends every pending invitation."
  local RESULTS="$1"
  local REMIND=false
  [ "${2:-}" = "--remind" ] && REMIND=true
  require_env
  [ -f "$RESULTS" ] || die "Results file not found: $RESULTS" \
                           "" \
                           "  'dwellkit class' writes one per run. Find yours with:" \
                           "      ls dwellkit-results-*.csv"

  local ACCEPTED=0 PENDING=0 MISSING=0
  local PENDING_LIST=()
  local student_id github_username repo credential status note

  # The file records which org it was built against. Checking a results file
  # from org A while GH_ORG points at org B would otherwise report every
  # student as REPO MISSING, which reads like a catastrophe rather than a typo.
  local FILE_ORG
  FILE_ORG="$(sed -n 's/^# org=//p' "$RESULTS" | head -1)"
  if [ -n "$FILE_ORG" ] && [ "$FILE_ORG" != "$GH_ORG" ]; then
    echo "FAIL: this results file was built against org '$FILE_ORG', but GH_ORG is '$GH_ORG'." >&2
    echo "      Set GH_ORG=$FILE_ORG, or pass the results file for $GH_ORG." >&2
    exit 1
  fi

  echo "==> Checking invitations against $RESULTS"
  [ -n "$FILE_ORG" ] && echo "    org: $FILE_ORG"
  echo

  while IFS=, read -r student_id github_username repo credential status notified note; do
    case "$student_id" in \#*) continue ;; esac   # provenance comments
    [ "$student_id" = "student_id" ] && continue   # column header
    [ -z "${repo:-}" ] && continue

    if ! gh api "repos/${GH_ORG}/${repo}" >/dev/null 2>&1; then
      printf '  %-14s %-18s  ✗ REPO MISSING\n' "$student_id" "$github_username"
      MISSING=$((MISSING+1)); continue
    fi

    # Accepted → appears as a collaborator. Not yet → appears under invitations.
    if gh api "repos/${GH_ORG}/${repo}/collaborators" --jq '.[].login' 2>/dev/null \
         | grep -qix "$github_username"; then
      printf '  %-14s %-18s  ✓ accepted\n' "$student_id" "$github_username"
      ACCEPTED=$((ACCEPTED+1))
    else
      local lower INV_ID
      lower="$(echo "$github_username" | tr '[:upper:]' '[:lower:]')"
      INV_ID="$(gh api "repos/${GH_ORG}/${repo}/invitations" \
                --jq ".[] | select(.invitee.login | ascii_downcase == \"$lower\") | .id" 2>/dev/null | head -1)"
      if [ -n "$INV_ID" ]; then
        printf '  %-14s %-18s  … PENDING\n' "$student_id" "$github_username"
        PENDING_LIST+=("${student_id},${github_username},${repo},${INV_ID}")
        PENDING=$((PENDING+1))
      else
        printf '  %-14s %-18s  ✗ NO INVITATION — re-run `dwellkit class`\n' "$student_id" "$github_username"
        MISSING=$((MISSING+1))
      fi
    fi
  done < "$RESULTS"

  echo
  echo "==> accepted: $ACCEPTED    pending: $PENDING    problems: $MISSING"

  if [ "$PENDING" -gt 0 ] && [ "$REMIND" = true ]; then
    echo
    echo "==> Re-sending pending invitations"
    local row sid ghu repo_ inv_id
    for row in "${PENDING_LIST[@]}"; do
      IFS=, read -r sid ghu repo_ inv_id <<< "$row"
      # Delete + recreate: GitHub re-sends the notification email.
      gh api -X DELETE "repos/${GH_ORG}/${repo_}/invitations/${inv_id}" >/dev/null 2>&1 || true
      if gh api -X PUT "repos/${GH_ORG}/${repo_}/collaborators/${ghu}" -f permission=push >/dev/null 2>&1; then
        echo "    re-sent: $sid ($ghu)"
      else
        echo "    FAILED to re-send: $sid ($ghu)" >&2
      fi
    done
  fi

  if [ "$PENDING" -gt 0 ]; then
    echo
    echo "    Students listed PENDING cannot clone their repository yet."
    echo "    Chase them, or re-send with:  ./dwellkit status $RESULTS --remind"
  fi

  [ "$MISSING" -gt 0 ] && exit 1 || exit 0
}

# ===========================================================================
# Dispatch
# ===========================================================================
case "${1:-help}" in
  build)       shift; cmd_build "$@" ;;
  class)       shift; cmd_class "$@" ;;
  status)      shift; cmd_status "$@" ;;
  _deploy-one) shift; cmd_deploy_one "$@" ;;
  help|-h|--help) usage ;;
  *)
    echo >&2
    echo "Unknown subcommand: '$1'" >&2
    case "$1" in
      dry*|validate*|check*) echo "Did you mean:  ./dwellkit class <roster.csv> --dry-run" >&2 ;;
      deploy*|fanout*|run*)  echo "Did you mean:  ./dwellkit class <roster.csv>" >&2 ;;
      invite*|remind*|chase*)echo "Did you mean:  ./dwellkit status <results.csv> --remind" >&2 ;;
      create*|new*|make*)    echo "Did you mean:  ./dwellkit build <student-id>" >&2 ;;
    esac
    echo >&2
    usage >&2
    exit 1 ;;
esac
